rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserOrg() {
      return getUserData().organizationId;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isStaff() {
      return isAuthenticated() && getUserRole() in ['admin', 'staff'];
    }

    function isReception() {
      return isAuthenticated() && getUserRole() in ['admin', 'staff', 'reception'];
    }

    function isBeautician() {
      return isAuthenticated() && getUserRole() in ['admin', 'staff', 'reception', 'beautician'];
    }

    function belongsToOrg(orgId) {
      return isAuthenticated() && getUserOrg() == orgId;
    }

    function hasClientPortalAccess(orgId) {
      return isAuthenticated()
             && exists(/databases/$(database)/documents/clientPortalAccess/$(request.auth.uid)/organizations/$(orgId));
    }

    function portalClientId(orgId) {
      return get(/databases/$(database)/documents/clientPortalAccess/$(request.auth.uid)/organizations/$(orgId)).data.client_id;
    }

    // Returns true if the update keeps the named field unchanged (or absent on both sides).
    function unchanged(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys());
    }

    match /users/{userId} {
      // Same-org members may read each other's user docs so that staff/reception/beautician
      // can populate the appointment-form staff and beautician selectors. The list query
      // in useSupabaseProfiles must filter by organizationId; without that filter this rule
      // will deny the query as soon as it returns a user from a different org.
      allow read: if isAuthenticated()
                  && (request.auth.uid == userId
                      || isAdmin()
                      || belongsToOrg(resource.data.organizationId));

      // User doc creation is done exclusively by the adminCreateUser Cloud Function
      // via the Admin SDK (which bypasses these rules). Blocking self-creation
      // prevents role self-assignment on first login.
      allow create: if false;

      // Self-update is allowed for profile fields only. Role, email, uid, createdAt
      // are immutable. organizationId may only transition null -> non-null (first-org
      // claim during OrganizationSetup); changing it afterwards must go through a
      // Cloud Function. Cross-org admins cannot modify users in other orgs.
      allow update: if isAuthenticated()
                    && (request.auth.uid == userId
                        || (isAdmin() && belongsToOrg(resource.data.organizationId)))
                    && unchanged('role')
                    && unchanged('email')
                    && unchanged('uid')
                    && unchanged('createdAt')
                    // Account (de)activation is an admin action. A user editing
                    // their own profile cannot flip isActive to re-enable a
                    // disabled account; only a same-org admin may change it.
                    && (unchanged('isActive')
                        || (isAdmin() && belongsToOrg(resource.data.organizationId)))
                    && (unchanged('organizationId')
                        || (resource.data.organizationId == null
                            && request.resource.data.organizationId is string
                            && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.created_by == request.auth.uid));

      allow delete: if false;

      // Session tracking sub-collection
      match /sessions/{sessionId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    match /organizations/{orgId} {
      allow read: if isAuthenticated() && (belongsToOrg(orgId) || hasClientPortalAccess(orgId));

      // Only users without an org can create their first org, and they must claim
      // it as creator. Blocks attackers from creating orgs they then hop into.
      allow create: if isAuthenticated()
                    && getUserData().organizationId == null
                    && request.resource.data.created_by == request.auth.uid;

      allow update: if isAuthenticated() && belongsToOrg(orgId) && isAdmin()
                    && unchanged('created_by')
                    && unchanged('created_at');
      allow delete: if false;

      match /clients/{clientId} {
        allow read: if (belongsToOrg(orgId) && isBeautician())
                    || (hasClientPortalAccess(orgId) && portalClientId(orgId) == clientId);
        allow create: if belongsToOrg(orgId) && isReception();
        allow update: if belongsToOrg(orgId) && isReception();
        // Hard-delete is denied — clients are soft-deleted via `deleted_at`.
        allow delete: if false;
      }

      match /appointments/{appointmentId} {
        allow read: if (belongsToOrg(orgId) && isBeautician())
                    || (hasClientPortalAccess(orgId) && resource.data.client_id == portalClientId(orgId));
        allow create: if belongsToOrg(orgId) && isReception();
        allow update: if belongsToOrg(orgId) && isReception();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      match /treatments/{treatmentId} {
        allow read: if (belongsToOrg(orgId) && isBeautician()) || hasClientPortalAccess(orgId);
        // Catalog edits are admin-only — front-desk can view but not change.
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      match /addons/{addonId} {
        allow read: if (belongsToOrg(orgId) && isBeautician()) || hasClientPortalAccess(orgId);
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      match /staff/{staffId} {
        allow read: if (belongsToOrg(orgId) && isBeautician()) || hasClientPortalAccess(orgId);
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      match /packages/{packageId} {
        allow read: if (belongsToOrg(orgId) && isBeautician()) || hasClientPortalAccess(orgId);
        // Packages are tied to revenue — admin-only writes.
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      match /purchases/{purchaseId} {
        allow read: if (belongsToOrg(orgId) && isBeautician())
                    || (hasClientPortalAccess(orgId) && resource.data.client_id == portalClientId(orgId));
        // Financial entity — admin-only writes; soft-delete via deleted_at.
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        // Purchases are a financial audit trail — no deletes.
        allow delete: if false;
      }

      match /products/{productId} {
        // Retail catalog carries prices — admin-only read. Non-admin staff never
        // surface product data in the UI (the Packages/Products tabs are
        // admin-only), so locking the read here closes the gap where a staff
        // user could pull prices directly via the SDK. Portal users still need
        // product reads for their own retail history.
        allow read: if (belongsToOrg(orgId) && isAdmin()) || hasClientPortalAccess(orgId);
        // Retail catalog — admin-only writes.
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      match /productCategories/{categoryId} {
        allow read: if belongsToOrg(orgId) && isBeautician();
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      match /productBrands/{brandId} {
        allow read: if belongsToOrg(orgId) && isBeautician();
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      match /productAssignments/{assignmentId} {
        // Carries assigned_price — admin-only read so non-admin staff cannot
        // pull retail revenue via the SDK. A portal user may still read their
        // own assignments. usePaginatedClients skips this fetch for non-admins.
        allow read: if (belongsToOrg(orgId) && isAdmin())
                    || (hasClientPortalAccess(orgId) && resource.data.client_id == portalClientId(orgId));
        // Retail assignment is a financial action — admin-only writes.
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      match /config/{configId} {
        // General config is broadly readable, but the sequential invoiceCounter
        // is admin-only — exposing it to every role leaks the invoice sequence.
        allow read: if belongsToOrg(orgId) && (isAdmin() || configId != 'invoiceCounter');
        // invoiceCounter is managed exclusively by the createInvoice Cloud
        // Function — client writes here would let an admin skip / duplicate
        // invoice numbers and break the audit trail.
        allow create, update: if belongsToOrg(orgId) && isAdmin()
                              && configId != 'invoiceCounter';
        allow delete: if false;
      }

      match /invoiceDrafts/{draftId} {
        // Invoice drafts: editable pre-issue scratch records that don't burn
        // an invoice number. Admin-only so they're consistent with the read
        // surface for issued invoices, but otherwise fully CRUD-able.
        allow read: if belongsToOrg(orgId) && isAdmin();
        allow create: if belongsToOrg(orgId) && isAdmin()
                      && request.resource.data.created_by == request.auth.uid;
        allow update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      match /invoices/{invoiceId} {
        allow read: if (belongsToOrg(orgId) && isAdmin())
                    || (hasClientPortalAccess(orgId)
                        && resource.data.client_id == portalClientId(orgId)
                        && resource.data.status == 'issued');
        // Invoice records are created by the createInvoice Cloud Function
        // (atomic counter + frozen snapshots + server-computed totals).
        allow create: if false;
        // The only client-side mutation allowed is attaching the PDF URL
        // once, after the admin has uploaded it to Storage. All monetary and
        // snapshot fields remain immutable.
        allow update: if belongsToOrg(orgId) && isAdmin()
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['pdf_url', 'pdf_storage_path'])
                      && resource.data.pdf_url == null;
        // Financial audit trail — no deletes. Use status = 'void' via a
        // future Cloud Function when reissue is needed.
        allow delete: if false;
      }

      match /businessHours/{docId} {
        allow read: if belongsToOrg(orgId) && isBeautician();
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      match /schedulingConfig/{docId} {
        allow read: if belongsToOrg(orgId) && isBeautician();
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      // Per-user staff availability — weekly schedule + dated overrides.
      // {staffId} matches the value stored as appointments.staff_id (a users/{uid} UID).
      // Booking flows on the staff CRM read all docs in this sub-collection to compute
      // available slots; portal/public reads happen via a Cloud Function (Admin SDK).
      match /staffSchedules/{staffId}/availability/{availId} {
        allow read: if belongsToOrg(orgId) && isBeautician();
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      // Per-org mirror of shareable scheduler links (one doc per token). Admin
      // reads them in the Scheduler Links settings UI. All writes flow through
      // Cloud Functions (createSchedulerLink / revokeSchedulerLink).
      match /schedulerLinks/{token} {
        allow read: if belongsToOrg(orgId) && isAdmin();
        allow create, update, delete: if false;
      }

      match /dropdownData/{docId} {
        // Staff reads + unauthenticated reads (public waiver/intake form needs city + referral-source options)
        allow read: if (belongsToOrg(orgId) && isBeautician()) || request.auth == null;
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      match /waiverTemplates/{templateId} {
        // The public waiver/intake form fetches ONE template by id (getDoc), so
        // allow unauthenticated get — but deny unauthenticated list so the full
        // set of templates (incl. legal agreement text) can't be enumerated by
        // anyone who knows an orgId. Staff may list.
        allow get: if (belongsToOrg(orgId) && isBeautician()) || request.auth == null;
        allow list: if belongsToOrg(orgId) && isBeautician();
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      match /clients/{clientId}/membershipHistory/{entryId} {
        allow read: if belongsToOrg(orgId) && isBeautician();
        // Membership lifecycle is admin-only.
        allow create: if belongsToOrg(orgId) && isAdmin();
        allow update, delete: if false;
      }

      match /clientWaivers/{waiverId} {
        allow read: if (belongsToOrg(orgId) && isBeautician())
                    || (request.auth == null
                        && resource.data.token is string
                        && exists(/databases/$(database)/documents/waiverTokens/$(resource.data.token))
                        && get(/databases/$(database)/documents/waiverTokens/$(resource.data.token)).data.waiverId == waiverId
                        && get(/databases/$(database)/documents/waiverTokens/$(resource.data.token)).data.organizationId == orgId
                        && get(/databases/$(database)/documents/waiverTokens/$(resource.data.token)).data.status == 'pending'
                        // Match the write path: an expired token must not grant
                        // read access to the signer's PII either.
                        && 'expiresAt' in get(/databases/$(database)/documents/waiverTokens/$(resource.data.token)).data.keys()
                        && get(/databases/$(database)/documents/waiverTokens/$(resource.data.token)).data.expiresAt > request.time);
        allow create, update: if belongsToOrg(orgId) && isReception();
        allow delete: if belongsToOrg(orgId) && isAdmin();

        // Unauthenticated waiver form: the signer must prove possession of a
        // valid, pending, unexpired token that points at THIS exact waiver doc.
        // This blocks orgId/waiverId enumeration attacks.
        allow update: if request.auth == null
                      && resource.data.status == 'pending'
                      && request.resource.data.status == 'signed'
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'signer_name', 'signer_email', 'signer_phone', 'answers', 'pdf_url', 'signed_at'])
                      && resource.data.token is string
                      && exists(/databases/$(database)/documents/waiverTokens/$(resource.data.token))
                      && get(/databases/$(database)/documents/waiverTokens/$(resource.data.token)).data.status == 'pending'
                      && get(/databases/$(database)/documents/waiverTokens/$(resource.data.token)).data.waiverId == waiverId
                      && get(/databases/$(database)/documents/waiverTokens/$(resource.data.token)).data.organizationId == orgId
                      // Require expiresAt to be present AND in the future.
                      // Previously this allowed missing-field as a pass; flip
                      // so a token without expiresAt is rejected (defense in
                      // depth — sendWaiver always writes the field, but a
                      // token created by hand wouldn't).
                      && 'expiresAt' in get(/databases/$(database)/documents/waiverTokens/$(resource.data.token)).data.keys()
                      && get(/databases/$(database)/documents/waiverTokens/$(resource.data.token)).data.expiresAt > request.time
                      // If the token was issued with OTP required, the signer
                      // must have proved phone possession via verifyFormOtp
                      // (which flips otpVerified to true). Tokens without
                      // requiresOtp == true pass freely — covers email/device
                      // delivery and legacy SMS without OTP.
                      && (get(/databases/$(database)/documents/waiverTokens/$(resource.data.token)).data.requiresOtp != true
                          || get(/databases/$(database)/documents/waiverTokens/$(resource.data.token)).data.otpVerified == true);
      }

      match /auditLogs/{logId} {
        allow read: if belongsToOrg(orgId) && isAdmin();
        allow write: if false; // Cloud Functions only
      }

      match /marketingCampaigns/{campaignId} {
        // Marketing is admin-only end-to-end.
        allow read: if belongsToOrg(orgId) && isAdmin();
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      match /marketingTemplates/{templateId} {
        allow read: if belongsToOrg(orgId) && isAdmin();
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      // Reusable SMS message templates (admin-managed).
      match /smsTemplates/{templateId} {
        allow read: if belongsToOrg(orgId) && isAdmin();
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      // Staff worklist for SMS/email cancellation + reschedule requests.
      // Created only by Cloud Functions (Admin SDK); staff read + resolve.
      match /appointmentAlerts/{alertId} {
        allow read: if belongsToOrg(orgId) && isReception();
        allow update: if belongsToOrg(orgId) && isReception();
        allow create: if false;
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      match /marketingAutomations/{automationId} {
        allow read: if belongsToOrg(orgId) && isAdmin();
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      match /campaignRecipients/{recipientId} {
        allow read: if belongsToOrg(orgId) && isAdmin();
        allow write: if false; // Cloud Functions only
      }

      // Stores third-party API keys (Resend, Twilio). Restricted to get-by-id
      // for admins; list is denied to avoid bulk-dumping API keys.
      match /marketingIntegrations/{integrationId} {
        allow get: if belongsToOrg(orgId) && isAdmin();
        allow list: if false;
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();

        // Write-only API secrets (API keys, auth tokens, webhook signing
        // secrets). Admin SDK (Cloud Functions) ONLY — the browser can never
        // read or write these, even with a stolen admin session. The parent
        // doc keeps only non-secret config + has_secret/secret_last4 hints.
        match /secret/{secretId} {
          allow read, write: if false;
        }
      }

      match /acuitySyncConfig/{docId} {
        allow read: if belongsToOrg(orgId) && isAdmin();
        allow create, update: if belongsToOrg(orgId) && isAdmin();
        allow delete: if belongsToOrg(orgId) && isAdmin();
      }

      match /acuitySyncLogs/{logId} {
        allow read: if belongsToOrg(orgId) && isAdmin();
        allow write: if false; // Cloud Functions only
      }

      match /clientCommunications/{commId} {
        // Front-desk needs to log/view client communications (paired with the
        // sendClientEmail CF that also accepts reception).
        allow read: if belongsToOrg(orgId) && isReception();
        allow create: if belongsToOrg(orgId) && isReception();
        // Communications are an audit record — no edits or deletes from clients.
        allow update, delete: if false;
      }

      match /bookingRequests/{requestId} {
        allow read: if (belongsToOrg(orgId) && isReception())
                    || (hasClientPortalAccess(orgId) && resource.data.client_id == portalClientId(orgId));
        allow create, update, delete: if false; // Cloud Functions only
      }

      // Rate limiters — Cloud Functions only
      match /rateLimits/{docId} {
        allow read: if false;
        allow write: if false;
      }
    }

    // Marketing quote-request leads — written exclusively by the submitQuoteRequest
    // Cloud Function (Admin SDK). Contain PII (name, email, phone); never readable
    // or writable from the client.
    match /marketingLeads/{leadId} {
      allow read, write: if false;
    }

    // Waiver tokens — unauthenticated clients fetch by known UUID to load their waiver.
    // `get` is allowed (knowing the UUID proves identity), but `list` is denied
    // so tokens cannot be enumerated. Updates are restricted to the pending→signed
    // flip and also guarded by the clientWaivers rule above.
    // OTP secrets — Cloud Functions (Admin SDK) only. Never readable by clients.
    match /otpCodes/{token} {
      allow read, write: if false;
    }

    match /waiverTokens/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if false; // Cloud Functions only
      allow delete: if false;
      allow update: if resource.data.status == 'pending'
                    && request.resource.data.status == 'signed'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'signedAt'])
                    // Require expiresAt — see /clientWaivers rule for context.
                    && 'expiresAt' in resource.data.keys()
                    && resource.data.expiresAt > request.time;
    }

    // Public scheduler-link tokens. Mirrors the waiverTokens security pattern:
    // any unauthenticated visitor may fetch a token by ID (knowing the token = identity
    // proof), but listing is denied so tokens cannot be enumerated. All writes happen
    // exclusively via Cloud Functions using the Admin SDK.
    match /schedulerLinkTokens/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /clientPortalAccess/{userId}/organizations/{orgId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false; // Cloud Functions only
    }

    // Master copies of waiver/intake/agreement templates seeded into every new
    // org by the seedOrgDefaultTemplates Cloud Function. Admin-only read so we
    // can preview them from the CRM; writes are Admin SDK only to keep masters
    // consistent across the platform. Use {{ORG_NAME}} as the brand token.
    match /defaultWaiverTemplates/{templateId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Master copies of marketing automations seeded alongside templates by the
    // same Cloud Function. Each master is keyed by trigger; the seeder skips
    // any trigger an org already has so re-running is safe. Body tokens
    // ([NAME], [DATE], [TIME], etc.) are resolved at email send time, not at
    // seed time, so no per-brand substitution happens here.
    match /defaultMarketingAutomations/{automationId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
