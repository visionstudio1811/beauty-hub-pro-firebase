rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Org of the currently signed-in user (from their Firestore profile).
    function callerOrg() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationId;
    }
    // Org that owns a given waiver token.
    function waiverOrg(waiverToken) {
      return firestore.get(/databases/(default)/documents/waiverTokens/$(waiverToken)).data.organizationId;
    }

    // Waiver PDFs and photos. Public uploads were previously allowed (relying
    // on a UUID token in the filename as "the secret") but the rule never
    // validated the filename pattern — anyone could PUT 50 MB blobs at any
    // path under waivers/. Now: all writes deny, and the public form uploads
    // exclusively through the `uploadWaiverFile` callable (Admin SDK), which
    // validates the token + MIME + size before writing.
    //
    // Reads are scoped to staff of the OWNING org (defense in depth). These
    // objects hold client PII + signatures; the previous `auth != null` let any
    // authenticated user of ANY tenant read them by path. Legitimate access uses
    // the download-token URL returned by uploadWaiverFile, which bypasses rules,
    // so this only removes cross-tenant SDK reads. The object name is
    // `{token}.pdf`, so the token is the filename minus its extension.
    match /waivers/{file} {
      allow read: if request.auth != null
                  && waiverOrg(file.split('\\.')[0]) == callerOrg();
      allow write: if false;
    }

    match /waivers/{token}/photos/{fileName} {
      allow read: if request.auth != null
                  && waiverOrg(token) == callerOrg();
      allow write: if false;
    }

    // Org logo. Public read (logos render in client portal + login screens
    // before auth), admin-only write, image MIME, size cap matches the UI.
    match /organizations/{orgId}/logo/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationId == orgId
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Product images live at `product-images/{orgId}/{filename}`. Restricted
    // to admins of the matching org so a user from one org cannot write into
    // another org's bucket prefix. Reads stay open to any signed-in user (the
    // catalog UI surfaces product images broadly).
    match /product-images/{orgId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationId == orgId
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Invoice PDFs live at `invoices/{orgId}/{invoiceId}.pdf`. Only admins of
    // the org may read/write, and uploads must be PDF under 5MB.
    match /invoices/{orgId}/{file} {
      allow read: if request.auth != null
                  && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationId == orgId
                  && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationId == orgId
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }

    // Default deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
